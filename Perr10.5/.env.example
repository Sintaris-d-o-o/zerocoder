# Скопируйте нужные строки в .env в папке zerocoder/ (на уровень выше папки задания).
# Файл .env никогда не коммитится в git.

# ── Вебхук цепочки n8n (задание 10.5) ────────────────────────────────────────
# Адрес берётся в n8n на узле Webhook: кнопка «Production URL».
# Для локального контейнера обычно вида http://localhost:5678/webhook/<path>
N8N_POST_WEBHOOK=http://localhost:5678/webhook/zerocoder-autopost

# Необязательно: если вебхук закрыт заголовком-секретом
# N8N_WEBHOOK_TOKEN=...

# ── Что нужно задать в самом n8n (переменные окружения контейнера) ───────────
# Цепочка берёт их из окружения, поэтому в файле рабочего процесса ключей нет:
#   TELEGRAM_BOT_TOKEN   — токен бота от BotFather
#   TELEGRAM_CHANNEL_ID  — канал: @имя_канала или числовой идентификатор вида -100…
