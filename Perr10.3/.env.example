# Скопируйте нужные строки в .env в папке zerocoder/ (на уровень выше папки задания).
# Файл .env никогда не коммитится в git.

# ── RouterAI (задание 10.3, используется по умолчанию) ───────────────────────
# Как получить: routerai.ru → регистрация → пополнить счёт → раздел с ключами API.
# Сервис-посредник: один ключ даёт доступ к видеомоделям разных компаний
# (Sora, Veo, Kling, Seedance, Runway и другим).
ROUTERAIRU_API_KEY=sk-...

# Необязательно: какую модель и какой сервис использовать.
# VIDEO_MODEL=google/veo-3.1-fast
# VIDEO_PROVIDER=routerai

# ── Proxy API (сервис из урока, запасной вариант) ────────────────────────────
# PROXYAPI_KEY=sk-...
# PROXYAPI_BASE_URL=https://api.proxyapi.ru/openai/v1
