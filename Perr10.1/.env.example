# Скопируйте эти строки в .env в папке zerocoder/ (на уровень выше папки задания)
# и подставьте свои значения. Файл .env никогда не коммитится в git.

# ── Yandex Cloud, доступ к Yandex ART (задания 10.1 и 10.2) ──────────────────
# Как получить:
#   1. console.yandex.cloud → создать платёжный аккаунт (нужен статус ACTIVE или TRIAL_ACTIVE);
#   2. создать каталог (folder) — его идентификатор вида b1g... и есть YANDEX_FOLDER_ID;
#   3. в каталоге создать сервисный аккаунт и выдать ему роль ai.imageGeneration.user;
#   4. у сервисного аккаунта создать API-ключ — его значение и есть YANDEX_API_KEY.
# Ключ показывается один раз при создании, сохраните сразу.
YANDEX_API_KEY=AQVN...
YANDEX_FOLDER_ID=b1g...

# ВАЖНО: у API-ключа Yandex Cloud есть собственная «область действия», которая
# задаётся при создании ключа и НЕ меняется ролями аккаунта. Ключ с областью
# yc.ai.languageModels.execute работает с текстом, но к генерации картинок его
# не пустят. Если при создании ключа можно выбрать только одну область — заведите
# второй ключ с областью yc.ai.imageGeneration.execute и положите его сюда:
# YANDEX_ART_API_KEY=AQVN...

# ── Proxy API, генерация видео (задание 10.3) ────────────────────────────────
# Как получить: зарегистрироваться на сервисе, пополнить баланс,
# раздел «Ключи API» → «Создать новый ключ API». Ключ виден только один раз.
PROXYAPI_KEY=sk-...
PROXYAPI_BASE_URL=https://api.proxyapi.ru/openai/v1
