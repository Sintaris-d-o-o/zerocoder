# Скопируйте нужные значения в .env в папку zerocoder/ (на уровень выше папки
# с заданием). Файл .env никогда не коммитится в git (см. корневой .gitignore).

# Ключ OpenAI — нужен для мощной модели (gpt-5), средней (gpt-5-mini) и экзаменатора.
OPENAI_API_KEY=sk-...

# Адрес локального Ollama (по умолчанию — этот же компьютер). Ключ не нужен.
OLLAMA_HOST=http://localhost:11434
