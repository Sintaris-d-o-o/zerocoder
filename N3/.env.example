# Шаблон переменных окружения для скриптов публикации n8n-воркфлоу.
# Скопируйте этот файл в .env и заполните значения своими.
# Настоящий .env в репозиторий не попадает (см. корневой .gitignore).

# ── Доступ к серверу по SSH ───────────────────────────────────────────────────
SSH_HOST=
SSH_USER=
SSH_PORT=
SSH_KEY_PATH=

# ── Контейнер n8n на сервере ──────────────────────────────────────────────────
N8N_DOCKER_CONTAINER=
N8N_DOCKER_DIR=
N8N_REQUIRES_SUDO=

# ── Доступ к n8n API ──────────────────────────────────────────────────────────
N8N_API_KEY=
N8N_HOST=
N8N_API_BASE=

# ── Идентификаторы воркфлоу и документов ──────────────────────────────────────
N8N_WORKFLOW_ID=
N8N_HR_WORKFLOW_ID=
N8N_WF_N3_HR_ASSISTANT_ID=
N8N_HR_SHEETS_DOC_ID=

# ── Идентификаторы и имена credentials внутри n8n ─────────────────────────────
N8N_OPENAI_CREDENTIAL_ID=
N8N_OPENAI_CREDENTIAL_NAME=
N8N_GSHEETS_CREDENTIAL_ID=
N8N_GSHEETS_CREDENTIAL_NAME=
N8N_GSHEETS_TRIGGER_CREDENTIAL_ID=
N8N_GSHEETS_TRIGGER_CREDENTIAL_NAME=
N8N_GMAIL_CREDENTIAL_ID=
N8N_GMAIL_CREDENTIAL_NAME=

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=

# ── Запуск тестов ─────────────────────────────────────────────────────────────
RUN_TESTS_REMOTE=

# ── Telegram-бот для уведомлений ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=
TELEGRAM_LONG_POLL_SECONDS=
