    {
      "id": "5",
      "name": "Extract Raw Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -220,
        220
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const html = ($json.body ?? $json.data ?? '').toString();\nconst original = { ...$json };\n\nconst text = html\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n  .replace(/<noscript[\\s\\S]*?<\\/noscript>/gi, ' ')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/&nbsp;/gi, ' ')\n  .replace(/&amp;/gi, '&')\n  .replace(/&lt;/gi, '<')\n  .replace(/&gt;/gi, '>')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nconst rawText = text.slice(0, 18000);\n\nreturn {\n  json: {\n    ...original,\n    raw_text: rawText\n  }\n};"
      }
    },
    {
      "id": "6",
      "name": "Generate Telegram Post (OpenAI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        20,
        220
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/responses",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.OPENAI_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"model\": \"{{$env.OPENAI_MODEL || 'gpt-4o-mini'}}\",\n  \"input\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Ты редактор Telegram-канала \\\"ИИ+ автоматизация бизнеса\\\". Пиши по-русски, дружелюбно и экспертно, без официоза. Создай пост длиной 1500-2000 символов. Структура: 1) вовлекающее введение, 2) основная часть с практической ценностью для предпринимателей/экспертов, 3) вывод и вопрос к аудитории. Не пиши рекламных клише.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Источник: {{$json.source_url}}\\n\\nКонтент статьи (очищенный):\\n{{$json.raw_text}}\"\n    }\n  ]\n}"
      }
    },
    {
      "id": "7",
      "name": "Normalize OpenAI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        220
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const data = $json;\nconst now = new Date().toISOString();\n\nlet postText = '';\n\nif (Array.isArray(data.output)) {\n  const chunks = [];\n  for (const block of data.output) {\n    if (!Array.isArray(block.content)) continue;\n    for (const part of block.content) {\n      if (typeof part.text === 'string' && part.text.trim()) {\n        chunks.push(part.text.trim());\n      }\n    }\n  }\n  postText = chunks.join('\\n\\n').trim();\n}\n\nif (!postText && typeof data.output_text === 'string') {\n  postText = data.output_text.trim();\n}\n\nif (!postText) {\n  throw new Error('OpenAI response did not contain post text');\n}\n\nreturn {\n  json: {\n    ...data,\n    post_text: postText,\n    status: 'done',\n    processed_at: now,\n    error: ''\n  }\n};"
      }
    },
