    {
      "id": "2",
      "name": "Validate Input Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -740,
        220
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const out = [];\nfor (const item of items) {\n  const row = item.json;\n  const sourceUrl = (row.source_url ?? '').toString().trim();\n  const status = (row.status ?? '').toString().trim().toLowerCase();\n\n  if (!sourceUrl) continue;\n  if (status && status !== 'new') continue;\n\n  out.push({\n    json: {\n      ...row,\n      source_url: sourceUrl,\n      status: 'processing',\n      error: ''\n    }\n  });\n}\nreturn out;"
      }
    },
